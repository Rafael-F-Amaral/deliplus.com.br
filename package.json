{
  "name": "deliplus",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "test:onboarding-coordinator": "node --test tests/onboarding-coordinator/onboarding-coordinator.test.mjs",
    "test:billing-checkout-ui": "node --test tests/billing-checkout-ui/billing-checkout-ui.test.mjs",
    "test:stripe-checkout": "node --conditions=react-server --experimental-strip-types --test tests/stripe-checkout/stripe-checkout.test.mjs tests/stripe-checkout/stripe-checkout.stripe.test.mjs",
    "test:stripe-checkout:concurrency": "node --conditions=react-server --experimental-strip-types --test tests/stripe-checkout/stripe-checkout.concurrency.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:tenant-provisioning": "node --conditions=react-server --experimental-strip-types --test tests/tenant-provisioning/*.test.mjs",
    "test:tenant-provisioning:integration": "node --conditions=react-server --experimental-strip-types --test tests/tenant-provisioning/*.integration.mjs",
    "test:onboarding-state-resolver": "node --test tests/onboarding/resolve-onboarding-state.test.mjs",
    "test:organization-entitlement": "node --experimental-strip-types --test tests/organization-entitlement/*.test.mjs",
    "test:store-provisioning-setup": "node --conditions=react-server --experimental-strip-types --test tests/store-provisioning-setup/*.test.mjs",
    "test:store-trial-activation": "node --conditions=react-server --experimental-strip-types --test tests/store-trial-activation/store-trial-activation.test.mjs",
    "test:store-trial-activation:concurrency": "node --test tests/store-trial-activation/store-trial-activation.concurrency.test.mjs",
    "test:store-entitlement-activation": "node --conditions=react-server --experimental-strip-types --test tests/store-entitlement-activation/store-entitlement-activation.test.mjs",
    "test:store-entitlement-activation:concurrency": "node --test tests/store-entitlement-activation/store-entitlement-activation.concurrency.test.mjs",
    "test:stripe-server-foundation": "node --conditions=react-server --experimental-strip-types --test tests/stripe-server-foundation/*.test.mjs",
    "test:stripe-webhook-foundation": "node --conditions=react-server --experimental-strip-types --test tests/stripe-webhook-foundation/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/localizations": "^4.15.4",
    "@clerk/nextjs": "^7.7.9",
    "@clerk/ui": "^1.30.5",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "stripe": "22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
